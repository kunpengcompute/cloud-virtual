From 82f54ce4d7b23c6a5f63ed562a226bedafb2bd09 Mon Sep 17 00:00:00 2001
From: lixuyuan4 <lixuyuan4@huawei.com>
Date: Thu, 20 Aug 2026 10:27:12 +0800
Subject: [PATCH] hw/arm/virt: build PPTT vcpu nodes in uniform core+thread
 shape

virt inclusion

category: feature

bugzilla: https://gitcode.com/boostkit/cloud-virtual/issues/28

CVE: NA

Always insert a real core node holding the core-level caches and hang
the vcpus of each core group as thread leaves under it. A single-vcpu
group simply becomes a one-thread core, which keeps the node shape
stable no matter how many vcpus a group holds (flexible CCL), and a
sole thread with no siblings still behaves as a non-SMT core for the
guest kernel.

Signed-off-by: Li Xuyuan <lixuyuan4@huawei.com>
---
 hw/arm/virt-acpi-build.c | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/hw/arm/virt-acpi-build.c b/hw/arm/virt-acpi-build.c
index 9fbbaabea4..ad4abd0aa5 100644
--- a/hw/arm/virt-acpi-build.c
+++ b/hw/arm/virt-acpi-build.c
@@ -285,16 +285,32 @@ static void build_pptt_auto_core(GArray *table_data, VirtMachineState *vms,
         }
     }
 
-    /* Build vcpu (processor) nodes under this core */
+    /*
+     * Build vcpu (processor) nodes under this core. Always insert a real
+     * core node holding the core-level caches and hang the vcpus of this
+     * group as thread leaves under it: a single-vcpu group simply becomes
+     * a one-thread core. This keeps the node shape stable no matter how
+     * many vcpus the group holds, and a sole thread with no siblings still
+     * behaves as a non-SMT core for the guest kernel.
+     */
+    uint32_t core_offset = table_data->len - pptt_start;
+
+    build_processor_hierarchy_node(
+        table_data,
+        0,             /* no flags: non-leaf, no ACPI ID */
+        cluster_offset, 0,
+        core_priv_rsrc, core_priv_num);
+
     for (m = 0; m < (int)core_grp->members->len; m++) {
         int vcpu_id = g_array_index(core_grp->members, int, m);
 
         build_processor_hierarchy_node(
             table_data,
             (1 << 1) |  /* ACPI Processor ID valid */
-            (1 << 3),    /* Node is a Leaf */
-            cluster_offset, vcpu_id,
-            core_priv_rsrc, core_priv_num);
+            (1 << 2) |  /* Processor is a thread */
+            (1 << 3),   /* Node is a Leaf */
+            core_offset, vcpu_id,
+            NULL, 0);
     }
 }
 
