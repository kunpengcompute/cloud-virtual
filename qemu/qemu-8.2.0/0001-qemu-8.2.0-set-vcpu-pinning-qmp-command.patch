+
+##
+# @VcpuPinningInfo:
+#
+# A vcpu-to-pcpu pinning mapping entry.
+#
+# @vcpu-id: virtual CPU index
+#
+# @pcpu-id: physical CPU index that this vcpu is pinned to
+#
+# Since: 8.10
+##
+{ 'struct': 'VcpuPinningInfo',
+  'data': { 'vcpu-id': 'int',
+            'pcpu-id': 'int' },
+  'if': { 'all': [ 'TARGET_ARM', 'CONFIG_KVM' ] } }
+
+##
+# @set-vcpu-pinning:
+#
+# Set the vcpu-to-pcpu pinning mapping for the virtual machine. This
+# command must be called before vcpu threads are created, during the
+# VM startup phase. When auto-topology is enabled, QEMU will query
+# the host's sysfs topology information for each pcpu and derive the
+# virtual CCL/socket topology accordingly, then build the PPTT table
+# based on the derived virtual topology.
+#
+# @auto-topology: whether to enable flexible CCL topology derivation.
+#     When true, QEMU derives virtual CCL and socket topology from
+#     the physical topology of the pinned pcpus.
+#
+# @vcpu-pinning: array of vcpu-to-pcpu pinning mappings
+#
+# Features:
+#
+# @unstable: This command is experimental.
+#
+# Returns: Nothing on success.
+#
+# Errors:
+#     - If @vcpu-id is out of range
+#     - If @pcpu-id is not online on the host
+#     - If the VM has already started (vcpu threads created)
+#
+# Since: 8.10
+##
+{ 'command': 'set-vcpu-pinning',
+  'data': { 'auto-topology': 'bool',
+            'vcpu-pinning': [ 'VcpuPinningInfo' ] },
+  'features': [ 'unstable' ],
+  'if': { 'all': [ 'TARGET_ARM', 'CONFIG_KVM' ] } }
