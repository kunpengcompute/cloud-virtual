+/*
+ * Flexible CCL (auto-topology) support for ARM virt machine
+ *
+ * This implements the QMP command `set-vcpu-pinning` which receives
+ * vcpu-to-pcpu pinning information from libvirt. When auto-topology
+ * is enabled, QEMU queries the host sysfs topology for each pcpu
+ * and derives virtual CCL/socket topology, which is then used to
+ * build the PPTT ACPI table.
+ *
+ * Copyright (c) 2024
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-machine-target.h"
+#include "hw/arm/virt.h"
+#include "hw/boards.h"
+#include "sysemu/kvm.h"
+#include "sysemu/runstate.h"
+#include "qemu/error-report.h"
+
+/* Cache type values: bit0=Instruction, bit1=Data, bit2=Unified (matches CLIDR CTYPE encoding) */
+#define VIRT_CACHE_TYPE_INSTRUCTION 0
+#define VIRT_CACHE_TYPE_DATA        1
+#define VIRT_CACHE_TYPE_UNIFIED     2
+
+/* Cache share scope values */
+#define VIRT_CACHE_SHARE_CORE   0
+#define VIRT_CACHE_SHARE_CCL    1
+#define VIRT_CACHE_SHARE_SOCKET 2
+
+/*
+ * Read a topology attribute from sysfs for a given pcpu.
+ * Returns -1 on error.
+ */
+int virt_read_pcpu_topology_attr(int pcpu_id, const char *attr)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *content = NULL;
+    GError *gerr = NULL;
+    long val;
+
+    path = g_strdup_printf("/sys/devices/system/cpu/cpu%d/topology/%s",
+                           pcpu_id, attr);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        error_report("Failed to read %s: %s", path, gerr->message);
+        g_error_free(gerr);
+        return -1;
+    }
+
+    val = strtol(content, NULL, 10);
+    return (int)val;
+}
+
+/*
+ * Read a sysfs attribute for a given pcpu as a string.
+ * attr is relative to /sys/devices/system/cpu/cpu<N>/
+ * Returns newly allocated string or NULL on error.
+ */
+char *virt_read_pcpu_attr_str(int pcpu_id, const char *attr)
+{
+    g_autofree char *path = NULL;
+    char *content = NULL;
+    GError *gerr = NULL;
+
+    path = g_strdup_printf("/sys/devices/system/cpu/cpu%d/%s",
+                           pcpu_id, attr);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        error_report("Failed to read %s: %s", path, gerr->message);
+        g_error_free(gerr);
+        return NULL;
+    }
+
+    return content;
+}
+
+/*
+ * Find the NUMA node ID that a pcpu belongs to by scanning
+ * /sys/devices/system/cpu/cpu<id>/node<N> directories.
+ * Returns node ID (>= 0) on success, or 0 on failure.
+ */
+static int virt_find_pcpu_node_id(int pcpu_id)
+{
+    int node_id = 0;
+    g_autofree char *cpu_path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d", pcpu_id);
+    DIR *dir = opendir(cpu_path);
+    if (dir) {
+        struct dirent *ent;
+        while ((ent = readdir(dir)) != NULL) {
+            int n;
+            if (sscanf(ent->d_name, "node%d", &n) == 1) {
+                node_id = n;
+                break;
+            }
+        }
+        closedir(dir);
+    }
+    return node_id;
+}
+
+/*
+ * Check if a pcpu is online on the host.
+ */
+static bool pcpu_is_online(int pcpu_id)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *content = NULL;
+    GError *gerr = NULL;
+
+    path = g_strdup_printf("/sys/devices/system/cpu/cpu%d/online",
+                           pcpu_id);
+    /* cpu0 always has no online file and is always online */
+    if (pcpu_id == 0) {
+        return true;
+    }
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        /* If the online file doesn't exist, the cpu is considered online */
+        g_error_free(gerr);
+        return true;
+    }
+    return strtol(content, NULL, 10) == 1;
+}
+
+/*
+ * Find the LLC (Last Level Cache) index for a given pcpu.
+ * Returns the index number, or -1 on error.
+ */
+int virt_find_llc_index(int pcpu_id)
+{
+    int max_level = 0;
+    int llc_index = -1;
+
+    for (int idx = 0; idx < 10; idx++) {
+        g_autofree char *path = NULL;
+        g_autofree char *content = NULL;
+        GError *gerr = NULL;
+        int level;
+
+        path = g_strdup_printf(
+            "/sys/devices/system/cpu/cpu%d/cache/index%d/level",
+            pcpu_id, idx);
+        if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+            g_error_free(gerr);
+            break;  /* no more indices */
+        }
+        level = strtol(content, NULL, 10);
+        if (level > max_level) {
+            max_level = level;
+            llc_index = idx;
+        }
+    }
+    return llc_index;
+}
+
+/*
+ * Read cache info from sysfs for a given pcpu and cache index.
+ * Returns true on success, false on error.
+ */
+bool virt_read_cache_info(int pcpu_id, int cache_index,
+                          struct VirtCacheInfo *info)
+{
+    g_autofree char *path = NULL;
+    g_autofree char *content = NULL;
+    GError *gerr = NULL;
+    g_autofree char *type_str = NULL;
+    g_autofree char *attr_path = NULL;
+
+    /* Read level */
+    path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d/cache/index%d/level",
+        pcpu_id, cache_index);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        g_error_free(gerr);
+        return false;
+    }
+    g_free(path);
+    info->level = strtol(content, NULL, 10);
+
+    /* Read type */
+    attr_path = g_strdup_printf("cache/index%d/type", cache_index);
+    type_str = virt_read_pcpu_attr_str(pcpu_id, attr_path);
+    if (!type_str) {
+        return false;
+    }
+    g_strstrip(type_str);
+    if (g_str_has_prefix(type_str, "Data")) {
+        info->type = VIRT_CACHE_TYPE_DATA;
+    } else if (g_str_has_prefix(type_str, "Instruction")) {
+        info->type = VIRT_CACHE_TYPE_INSTRUCTION;
+    } else {
+        info->type = VIRT_CACHE_TYPE_UNIFIED;
+    }
+
+    /* Read size (e.g. "65536" or "64K") */
+    g_free(content);
+    content = NULL;
+    path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d/cache/index%d/size",
+        pcpu_id, cache_index);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        g_error_free(gerr);
+        return false;
+    }
+    g_free(path);
+    g_strstrip(content);
+    {
+        long sz = strtol(content, NULL, 10);
+        char *end = NULL;
+        strtol(content, &end, 10);
+        if (end && *end == 'K') {
+            sz *= 1024;
+        } else if (end && *end == 'M') {
+            sz *= 1024 * 1024;
+        }
+        info->size = (uint32_t)sz;
+    }
+
+    /* Read coherency_line_size */
+    g_free(content);
+    content = NULL;
+    path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d/cache/index%d/coherency_line_size",
+        pcpu_id, cache_index);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        g_error_free(gerr);
+        return false;
+    }
+    g_free(path);
+    info->line_size = (uint16_t)strtol(content, NULL, 10);
+
+    /* Read number_of_sets */
+    g_free(content);
+    content = NULL;
+    path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d/cache/index%d/number_of_sets",
+        pcpu_id, cache_index);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        g_error_free(gerr);
+        return false;
+    }
+    g_free(path);
+    info->sets = (uint32_t)strtol(content, NULL, 10);
+
+    /* Read ways_of_associativity */
+    g_free(content);
+    content = NULL;
+    path = g_strdup_printf(
+        "/sys/devices/system/cpu/cpu%d/cache/index%d/ways_of_associativity",
+        pcpu_id, cache_index);
+    if (!g_file_get_contents(path, &content, NULL, &gerr)) {
+        g_error_free(gerr);
+        return false;
+    }
+    info->associativity = (uint8_t)strtol(content, NULL, 10);
+
+    /* PPTT Attributes field:
+     *   Bits [1:0]: Allocation: 0=Read, 1=Write, 2/3=ReadWrite
+     *   Bits [3:2]: Cache type: 0=Data, 1=Instruction, 2/3=Unified
+     *   Bit  [4]:   Write policy: 0=WriteBack, 1=WriteThrough
+     *   Bits [7:5]: Reserved, must be zero
+     */
+    if (info->type == VIRT_CACHE_TYPE_INSTRUCTION) {
+        /* Read allocate | Instruction | WriteBack */
+        info->attributes = (0 << 4) | (1 << 2) | 0;  /* 0x04 */
+    } else if (info->type == VIRT_CACHE_TYPE_DATA) {
+        /* ReadWrite allocate | Data | WriteBack */
+        info->attributes = (0 << 4) | (0 << 2) | 2;  /* 0x02 */
+    } else {
+        /* ReadWrite allocate | Unified | WriteBack */
+        info->attributes = (0 << 4) | (2 << 2) | 2;  /* 0x0A */
+    }
+
+    info->share_scope = VIRT_CACHE_SHARE_CORE;
+
+    return true;
+}
+
+/*
+ * Determine the share scope of a cache by comparing its shared_cpu_list
+ * against the core/ccl/socket grouping in cpu_topology.
+ * Returns VIRT_CACHE_SHARE_CORE/CCL/SOCKET.
+ */
+int virt_determine_cache_share_scope(int pin_idx, int cache_index,
+                                     VirtMachineState *vms)
+{
+    int pcpu_id = vms->vcpu_pinning[pin_idx].pcpu_id;
+    g_autofree char *attr_path = g_strdup_printf(
+        "cache/index%d/shared_cpu_list", cache_index);
+    g_autofree char *shared_cpu_list = virt_read_pcpu_attr_str(pcpu_id,
+                                                                attr_path);
+    char *core_cpus_list = vms->vcpu_pinning[pin_idx].core_cpus_list;
+    char *cluster_cpus_list = vms->vcpu_pinning[pin_idx].cluster_cpus_list;
+
+    if (!shared_cpu_list) {
+        return VIRT_CACHE_SHARE_CORE;
+    }
+    g_strstrip(shared_cpu_list);
+
+    if (core_cpus_list && g_str_equal(shared_cpu_list, core_cpus_list)) {
+        return VIRT_CACHE_SHARE_CORE;
+    }
+
+    if (cluster_cpus_list && g_str_equal(shared_cpu_list, cluster_cpus_list)) {
+        return VIRT_CACHE_SHARE_CCL;
+    }
+
+    return VIRT_CACHE_SHARE_SOCKET;
+}
+
+/*
+ * Determine LLC binding strategy by comparing NUMA node cpu range
+ * with LLC cache shared cpu range.
+ *
+ * If NUMA node range == LLC cache range: LLC binds at socket level
+ * If LLC cache range == CCL range: LLC binds at CCL level
+ */
+static bool determine_llc_binding_strategy(int pcpu_id)
+{
+    g_autofree char *numa_cpulist = NULL;
+    g_autofree char *llc_cpulist = NULL;
+    g_autofree char *attr_path = NULL;
+    int llc_index;
+
+    /* Find which NUMA node this pcpu belongs to, then read its cpulist */
+    {
+        int node_id = virt_find_pcpu_node_id(pcpu_id);
+        g_autofree char *node_attr = g_strdup_printf("node%d/cpulist", node_id);
+        numa_cpulist = virt_read_pcpu_attr_str(pcpu_id, node_attr);
+    }
+    if (!numa_cpulist) {
+        /* Fallback: assume LLC at socket level */
+        return false;
+    }
+
+    /* Find LLC index and read its shared_cpu_list */
+    llc_index = virt_find_llc_index(pcpu_id);
+    if (llc_index < 0) {
+        return false;
+    }
+
+    attr_path = g_strdup_printf("cache/index%d/shared_cpu_list", llc_index);
+    llc_cpulist = virt_read_pcpu_attr_str(pcpu_id, attr_path);
+    if (!llc_cpulist) {
+        return false;
+    }
+
+    g_strstrip(numa_cpulist);
+    g_strstrip(llc_cpulist);
+
+    /* If NUMA node cpu range == LLC cache range, LLC at socket level */
+    return g_str_equal(numa_cpulist, llc_cpulist);
+}
+
+/* Helper to free a VirtTopoGroup when used as GHashTable value */
+static void virt_topo_group_free(gpointer data)
+{
+    VirtTopoGroup *grp = (VirtTopoGroup *)data;
+    if (grp->members) {
+        g_array_free(grp->members, true);
+    }
+    g_free(grp);
+}
+
+/*
+ * Derive virtual topology from pcpu topology.
+ *
+ * This implements the vCPU topology grouping logic from the design doc:
+ * 1. Check host topology to determine LLC binding strategy
+ * 2. For each vcpu, query pcpu topology (core_id, cluster_id, socket key)
+ *    and directly build cpu_topology groups using physical IDs as keys
+ */
+static void derive_auto_topology(VirtMachineState *vms)
+{
+    int i, j;
+    int next_vcore = 0;
+    int next_vcluster = 0;
+    int next_vsocket = 0;
+    int llc_index;
+    int first_pcpu;
+
+    /* Phase 1: Determine LLC binding strategy using the first pcpu */
+    first_pcpu = vms->vcpu_pinning[0].pcpu_id;
+    vms->llc_bind_at_socket = determine_llc_binding_strategy(first_pcpu);
+    llc_index = virt_find_llc_index(first_pcpu);
+
+    /* Initialize cpu_topology groups: physical ID -> VirtTopoGroup */
+    vms->cpu_topology.core_group = g_hash_table_new_full(g_direct_hash,
+        g_direct_equal, NULL, (GDestroyNotify)virt_topo_group_free);
+    vms->cpu_topology.ccl_group = g_hash_table_new_full(g_direct_hash,
+        g_direct_equal, NULL, (GDestroyNotify)virt_topo_group_free);
+    vms->cpu_topology.socket_group = g_hash_table_new_full(g_direct_hash,
+        g_direct_equal, NULL, (GDestroyNotify)virt_topo_group_free);
+
+    /*
+     * Phase 2: Iterate each vcpu, query pcpu topology to determine
+     * core/ccl/socket grouping, following the design doc flow:
+     *   - Read pcpu topology/core_id for core grouping
+     *   - Read pcpu topology/cluster_id for ccl grouping
+     *   - If LLC as socket basis: use LLC shared_cpu_list first cpu as socket key
+     *   - Else: use NUMA node id as socket key
+     * Directly build cpu_topology groups using physical IDs as keys.
+     */
+    for (i = 0; i < vms->nr_vcpu_pinning; i++) {
+        int pcpu_id = vms->vcpu_pinning[i].pcpu_id;
+        int vcpu_id = vms->vcpu_pinning[i].vcpu_id;
+        int phys_core = virt_read_pcpu_topology_attr(pcpu_id, "core_id");
+        int phys_cluster = virt_read_pcpu_topology_attr(pcpu_id, "cluster_id");
+        int phys_socket_key;
+
+        if (phys_core < 0) {
+            phys_core = 0;
+        }
+        if (phys_cluster < 0) {
+            phys_cluster = phys_core;  /* fallback */
+        }
+
+        /* Determine socket key based on LLC binding strategy */
+        if (vms->llc_bind_at_socket) {
+            /* Use LLC shared_cpu_list first cpu as socket key */
+            g_autofree char *attr_path = g_strdup_printf(
+                "cache/index%d/shared_cpu_list", llc_index);
+            g_autofree char *llc_cpulist = virt_read_pcpu_attr_str(pcpu_id,
+                                                               attr_path);
+            if (llc_cpulist) {
+                g_autofree char *copy = g_strdup(llc_cpulist);
+                char *dash, *comma;
+                g_strstrip(copy);
+                /* Parse the first cpu id from the list */
+                dash = strchr(copy, '-');
+                comma = strchr(copy, ',');
+                if (dash && (!comma || dash < comma)) {
+                    *dash = '\0';
+                } else if (comma) {
+                    *comma = '\0';
+                }
+                phys_socket_key = strtol(copy, NULL, 10);
+            } else {
+                phys_socket_key = virt_read_pcpu_topology_attr(pcpu_id,
+                                                          "physical_package_id");
+                if (phys_socket_key < 0) {
+                    phys_socket_key = 0;
+                }
+            }
+        } else {
+            /* Use NUMA node as socket key */
+            phys_socket_key = virt_find_pcpu_node_id(pcpu_id);
+        }
+
+        /*
+         * Build core_group: phys_core_id -> VirtTopoGroup
+         * If new core, assign next virtual ID; otherwise use existing vid.
+         * Append vcpu_id to the group's members array.
+         */
+        VirtTopoGroup *core_grp = g_hash_table_lookup(
+            vms->cpu_topology.core_group, GINT_TO_POINTER(phys_core));
+        if (!core_grp) {
+            core_grp = g_new0(VirtTopoGroup, 1);
+            core_grp->vid = next_vcore++;
+            core_grp->members = g_array_new(false, false, sizeof(int));
+            g_hash_table_insert(vms->cpu_topology.core_group,
+                                GINT_TO_POINTER(phys_core), core_grp);
+        }
+        vms->vcpu_pinning[i].vcore_id = core_grp->vid;
+        g_array_append_val(core_grp->members, vcpu_id);
+
+        /*
+         * Build ccl_group: phys_cluster_id -> VirtTopoGroup
+         * Members are phys_core_ids (deduplicated).
+         */
+        VirtTopoGroup *ccl_grp = g_hash_table_lookup(
+            vms->cpu_topology.ccl_group, GINT_TO_POINTER(phys_cluster));
+        if (!ccl_grp) {
+            ccl_grp = g_new0(VirtTopoGroup, 1);
+            ccl_grp->vid = next_vcluster++;
+            ccl_grp->members = g_array_new(false, false, sizeof(int));
+            g_hash_table_insert(vms->cpu_topology.ccl_group,
+                                GINT_TO_POINTER(phys_cluster), ccl_grp);
+        }
+        vms->vcpu_pinning[i].vcluster_id = ccl_grp->vid;
+        /* Deduplicate: only add phys_core if not already present */
+        {
+            bool found = false;
+            for (j = 0; j < (int)ccl_grp->members->len; j++) {
+                if (g_array_index(ccl_grp->members, int, j) == phys_core) {
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                g_array_append_val(ccl_grp->members, phys_core);
+            }
+        }
+
+        /*
+         * Build socket_group: phys_socket_key -> VirtTopoGroup
+         * Members are phys_cluster_ids (deduplicated).
+         */
+        VirtTopoGroup *sock_grp = g_hash_table_lookup(
+            vms->cpu_topology.socket_group, GINT_TO_POINTER(phys_socket_key));
+        if (!sock_grp) {
+            sock_grp = g_new0(VirtTopoGroup, 1);
+            sock_grp->vid = next_vsocket++;
+            sock_grp->members = g_array_new(false, false, sizeof(int));
+            g_hash_table_insert(vms->cpu_topology.socket_group,
+                                GINT_TO_POINTER(phys_socket_key), sock_grp);
+        }
+        vms->vcpu_pinning[i].vsocket_id = sock_grp->vid;
+        /* Deduplicate: only add phys_cluster if not already present */
+        {
+            bool found = false;
+            for (j = 0; j < (int)sock_grp->members->len; j++) {
+                if (g_array_index(sock_grp->members, int, j) == phys_cluster) {
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                g_array_append_val(sock_grp->members, phys_cluster);
+            }
+        }
+    }
+
+    vms->nr_vsockets = next_vsocket;
+    vms->nr_vclusters = next_vcluster;
+    vms->nr_vcores = next_vcore;
+}
+
+void qmp_set_vcpu_pinning(bool auto_topology,
+                          VcpuPinningInfoList *vcpu_pinning,
+                          Error **errp)
+{
+    MachineState *ms = MACHINE(qdev_get_machine());
+    VirtMachineState *vms = VIRT_MACHINE(ms);
+    VcpuPinningInfoList *entry;
+    int i;
+    int nr_entries = 0;
+    int max_vcpu_id = ms->smp.max_cpus - 1;
+
+    /* Must be called before vcpu threads are created */
+    if (runstate_check(RUN_STATE_RUNNING)) {
+        error_setg(errp, "set-vcpu-pinning must be called before VM startup");
+        return;
+    }
+
+    /* Validate: auto_topology must be true for now */
+    if (!auto_topology) {
+        error_setg(errp, "auto-topology must be set to true");
+        return;
+    }
+
+    /* Count entries */
+    for (entry = vcpu_pinning; entry; entry = entry->next) {
+        nr_entries++;
+    }
+
+    if (nr_entries == 0) {
+        error_setg(errp, "vcpu-pinning array must not be empty");
+        return;
+    }
+
+    /* Validate each entry */
+    for (entry = vcpu_pinning; entry; entry = entry->next) {
+        int vcpu_id = entry->value->vcpu_id;
+        int pcpu_id = entry->value->pcpu_id;
+
+        if (vcpu_id < 0 || vcpu_id > max_vcpu_id) {
+            error_setg(errp, "vcpu-id %d is out of range (0-%d)",
+                       vcpu_id, max_vcpu_id);
+            return;
+        }
+
+        if (!pcpu_is_online(pcpu_id)) {
+            error_setg(errp, "pcpu-id %d is not online", pcpu_id);
+            return;
+        }
+    }
+
+    /* Check for duplicate vcpu-id entries */
+    for (entry = vcpu_pinning; entry; entry = entry->next) {
+        VcpuPinningInfoList *other;
+        for (other = entry->next; other; other = other->next) {
+            if (entry->value->vcpu_id == other->value->vcpu_id) {
+                error_setg(errp, "duplicate vcpu-id %d",
+                           entry->value->vcpu_id);
+                return;
+            }
+        }
+    }
+
+    /* Free any previously allocated topology data */
+    if (vms->vcpu_pinning) {
+        for (int j = 0; j < vms->nr_vcpu_pinning; j++) {
+            g_free(vms->vcpu_pinning[j].core_cpus_list);
+            g_free(vms->vcpu_pinning[j].cluster_cpus_list);
+        }
+    }
+    g_free(vms->vcpu_pinning);
+    if (vms->cpu_topology.core_group) {
+        g_hash_table_destroy(vms->cpu_topology.core_group);
+        vms->cpu_topology.core_group = NULL;
+    }
+    if (vms->cpu_topology.ccl_group) {
+        g_hash_table_destroy(vms->cpu_topology.ccl_group);
+        vms->cpu_topology.ccl_group = NULL;
+    }
+    if (vms->cpu_topology.socket_group) {
+        g_hash_table_destroy(vms->cpu_topology.socket_group);
+        vms->cpu_topology.socket_group = NULL;
+    }
+
+    /* Store pinning info */
+    vms->auto_topology = auto_topology;
+    vms->nr_vcpu_pinning = nr_entries;
+    vms->vcpu_pinning = g_new0(struct VcpuAutoTopologyEntry, nr_entries);
+
+    for (entry = vcpu_pinning, i = 0; entry; entry = entry->next, i++) {
+        int pcpu_id = entry->value->pcpu_id;
+        vms->vcpu_pinning[i].vcpu_id = entry->value->vcpu_id;
+        vms->vcpu_pinning[i].pcpu_id = pcpu_id;
+        /* Cache topology cpulist strings to avoid repeated sysfs reads */
+        vms->vcpu_pinning[i].core_cpus_list =
+            virt_read_pcpu_attr_str(pcpu_id, "topology/core_cpus_list");
+        if (vms->vcpu_pinning[i].core_cpus_list) {
+            g_strstrip(vms->vcpu_pinning[i].core_cpus_list);
+        }
+        vms->vcpu_pinning[i].cluster_cpus_list =
+            virt_read_pcpu_attr_str(pcpu_id, "topology/cluster_cpus_list");
+        if (vms->vcpu_pinning[i].cluster_cpus_list) {
+            g_strstrip(vms->vcpu_pinning[i].cluster_cpus_list);
+        }
+    }
+
+    /* Derive virtual topology from physical topology */
+    derive_auto_topology(vms);
+
+    /* Update possible_cpus props to reflect the auto topology */
+    if (ms->possible_cpus) {
+        for (i = 0; i < vms->nr_vcpu_pinning; i++) {
+            int vcpu_id = vms->vcpu_pinning[i].vcpu_id;
+            if (vcpu_id < ms->possible_cpus->len) {
+                ms->possible_cpus->cpus[vcpu_id].props.socket_id =
+                    vms->vcpu_pinning[i].vsocket_id;
+                ms->possible_cpus->cpus[vcpu_id].props.cluster_id =
+                    vms->vcpu_pinning[i].vcluster_id;
+                ms->possible_cpus->cpus[vcpu_id].props.core_id =
+                    vms->vcpu_pinning[i].vcore_id;
+            }
+        }
+    }
+}
