---
 src/conf/cpu_conf.c           | 83 ++++++++++++++++++++++++-----------
 src/conf/cpu_conf.h           |  3 +-
 src/conf/schemas/cputypes.rng | 47 ++++++++++++--------
 3 files changed, 88 insertions(+), 45 deletions(-)

diff --git a/src/conf/cpu_conf.c b/src/conf/cpu_conf.c
index 6e6e1b9a89..54e196a085 100644
--- a/src/conf/cpu_conf.c
+++ b/src/conf/cpu_conf.c
@@ -26,6 +26,7 @@
 #include "virbuffer.h"
 #include "virfile.h"
 #include "cpu_conf.h"
+#include "virstring.h"
 #include "virlog.h"
 
 #define VIR_FROM_THIS VIR_FROM_CPU
@@ -244,6 +245,7 @@ virCPUDefCopyWithoutModel(const virCPUDef *cpu)
     copy->clusters = cpu->clusters;
     copy->cores = cpu->cores;
     copy->threads = cpu->threads;
+    copy->auto_topology = cpu->auto_topology;
     copy->arch = cpu->arch;
     copy->migratable = cpu->migratable;
     copy->sigFamily = cpu->sigFamily;
@@ -560,35 +562,59 @@ virCPUDefParseXML(xmlXPathContextPtr ctxt,
     }
 
     if ((topology = virXPathNode("./topology[1]", ctxt))) {
+        g_autofree char *auto_topology = NULL;
 
-        if (virXMLPropUInt(topology, "sockets", 10,
-                           VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                           &def->sockets) < 0) {
-            return -1;
+        if ((auto_topology = virXMLPropString(topology, "auto_topology"))) {
+            if (virStringParseYesNo(auto_topology, &def->auto_topology) < 0) {
+                virReportError(VIR_ERR_XML_ERROR,
+                               _("invalid auto_topology attribute '%1$s'"),
+                               auto_topology);
+                return -1;
+            }
         }
 
-        if (virXMLPropUIntDefault(topology, "dies", 10,
-                                  VIR_XML_PROP_NONZERO,
-                                  &def->dies, 1) < 0) {
-            return -1;
-        }
+        if (def->auto_topology) {
+            /* auto_topology conflicts with explicit socket/dies/clusters/
+             * cores/threads configuration, they must not be present. */
+            if (virXMLPropString(topology, "sockets") ||
+                virXMLPropString(topology, "dies") ||
+                virXMLPropString(topology, "clusters") ||
+                virXMLPropString(topology, "cores") ||
+                virXMLPropString(topology, "threads")) {
+                virReportError(VIR_ERR_XML_ERROR, "%s",
+                               _("auto_topology conflicts with explicit socket/dies/clusters/cores/threads configuration"));
+                return -1;
+            }
+        } else {
+            if (virXMLPropUInt(topology, "sockets", 10,
+                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
+                               &def->sockets) < 0) {
+                return -1;
+            }
 
-        if (virXMLPropUIntDefault(topology, "clusters", 10,
-                                  VIR_XML_PROP_NONZERO,
-                                  &def->clusters, 1) < 0) {
-            return -1;
-        }
+            if (virXMLPropUIntDefault(topology, "dies", 10,
+                                      VIR_XML_PROP_NONZERO,
+                                      &def->dies, 1) < 0) {
+                return -1;
+            }
 
-        if (virXMLPropUInt(topology, "cores", 10,
-                           VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                           &def->cores) < 0) {
-            return -1;
-        }
+            if (virXMLPropUIntDefault(topology, "clusters", 10,
+                                      VIR_XML_PROP_NONZERO,
+                                      &def->clusters, 1) < 0) {
+                return -1;
+            }
 
-        if (virXMLPropUInt(topology, "threads", 10,
-                           VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                           &def->threads) < 0) {
-            return -1;
+            if (virXMLPropUInt(topology, "cores", 10,
+                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
+                               &def->cores) < 0) {
+                return -1;
+            }
+
+            if (virXMLPropUInt(topology, "threads", 10,
+                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
+                               &def->threads) < 0) {
+                return -1;
+            }
         }
     }
 
@@ -834,7 +860,9 @@ virCPUDefFormatBuf(virBuffer *buf,
         virBufferAddLit(buf, "/>\n");
     }
 
-    if (def->sockets && def->dies && def->clusters && def->cores && def->threads) {
+    if (def->auto_topology) {
+        virBufferAddLit(buf, "<topology auto_topology='yes'/>\n");
+    } else if (def->sockets && def->dies && def->clusters && def->cores && def->threads) {
         virBufferAddLit(buf, "<topology");
         virBufferAsprintf(buf, " sockets='%u'", def->sockets);
         virBufferAsprintf(buf, " dies='%u'", def->dies);
@@ -1132,6 +1160,11 @@ virCPUDefIsEqual(virCPUDef *src,
         return false;
     }
 
+    if (src->auto_topology != dst->auto_topology) {
+        MISMATCH("%s", _("Target CPU auto_topology does not match source"));
+        return false;
+    }
+
     if ((src->addr && !dst->addr) ||
         (!src->addr && dst->addr) ||
         (src->addr && dst->addr &&
@@ -1242,4 +1275,4 @@ virCPUDefListFree(virCPUDef **cpus)
         virCPUDefFree(*cpu);
 
     g_free(cpus);
-}
+}
\ No newline at end of file
diff --git a/src/conf/cpu_conf.h b/src/conf/cpu_conf.h
index 2694022fed..3c341b1bea 100644
--- a/src/conf/cpu_conf.h
+++ b/src/conf/cpu_conf.h
@@ -151,6 +151,7 @@ struct _virCPUDef {
     unsigned int clusters;
     unsigned int cores;
     unsigned int threads;
+    bool auto_topology; /* auto topology derived from vcpu pinning (flexible CCL) */
     unsigned int sigFamily;
     unsigned int sigModel;
     unsigned int sigStepping;
@@ -275,4 +276,4 @@ virCPUDefListParse(const char **xmlCPUs,
                    unsigned int ncpus,
                    virCPUType cpuType);
 void
-virCPUDefListFree(virCPUDef **cpus);
+virCPUDefListFree(virCPUDef **cpus);
\ No newline at end of file
diff --git a/src/conf/schemas/cputypes.rng b/src/conf/schemas/cputypes.rng
index 3a8910e09f..3b6c3a54fb 100644
--- a/src/conf/schemas/cputypes.rng
+++ b/src/conf/schemas/cputypes.rng
@@ -84,25 +84,34 @@
 
   <define name="cpuTopology">
     <element name="topology">
-      <attribute name="sockets">
-        <ref name="positiveInteger"/>
-      </attribute>
-      <optional>
-        <attribute name="dies">
-          <ref name="positiveInteger"/>
-        </attribute>
-      </optional>
-      <optional>
-        <attribute name="clusters">
-          <ref name="positiveInteger"/>
+      <choice>
+        <!-- auto_topology derives the topology from vcpu pinning and
+             conflicts with explicit socket/dies/clusters/cores/threads -->
+        <attribute name="auto_topology">
+          <ref name="virYesNo"/>
         </attribute>
-      </optional>
-      <attribute name="cores">
-        <ref name="positiveInteger"/>
-      </attribute>
-      <attribute name="threads">
-        <ref name="positiveInteger"/>
-      </attribute>
+        <group>
+          <attribute name="sockets">
+            <ref name="positiveInteger"/>
+          </attribute>
+          <optional>
+            <attribute name="dies">
+              <ref name="positiveInteger"/>
+            </attribute>
+          </optional>
+          <optional>
+            <attribute name="clusters">
+              <ref name="positiveInteger"/>
+            </attribute>
+          </optional>
+          <attribute name="cores">
+            <ref name="positiveInteger"/>
+          </attribute>
+          <attribute name="threads">
+            <ref name="positiveInteger"/>
+          </attribute>
+        </group>
+      </choice>
     </element>
   </define>
 
@@ -470,4 +479,4 @@
     </element>
   </define>
 
-</grammar>
+</grammar>
\ No newline at end of file
