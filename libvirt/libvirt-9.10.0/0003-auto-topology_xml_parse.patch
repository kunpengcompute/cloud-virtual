diff --git a/src/conf/cpu_conf.c b/src/conf/cpu_conf.c
index 54e196a085..b8784d174c 100644
--- a/src/conf/cpu_conf.c
+++ b/src/conf/cpu_conf.c
@@ -26,6 +26,7 @@
 #include "virbuffer.h"
 #include "virfile.h"
 #include "cpu_conf.h"
+#include "domain_conf.h"
 #include "virstring.h"
 #include "virlog.h"
 
@@ -299,7 +300,7 @@ virCPUDefParseXMLString(const char *xml,
     if (!(doc = virXMLParseStringCtxt(xml, _("(CPU_definition)"), &ctxt)))
         return -1;
 
-    if (virCPUDefParseXML(ctxt, NULL, type, cpu, validateXML) < 0)
+    if (virCPUDefParseXML(ctxt, NULL, type, cpu, validateXML, NULL, 0) < 0)
         return -1;
 
     return 0;
@@ -351,7 +352,9 @@ virCPUDefParseXML(xmlXPathContextPtr ctxt,
                   const char *xpath,
                   virCPUType type,
                   virCPUDef **cpu,
-                  bool validateXML)
+                  bool validateXML,
+                  virDomainVcpuDef **vcpus,
+                  size_t maxvcpus)
 {
     g_autoptr(virCPUDef) def = NULL;
     g_autofree xmlNodePtr *nodes = NULL;
@@ -573,46 +576,70 @@ virCPUDefParseXML(xmlXPathContextPtr ctxt,
             }
         }
 
-        if (def->auto_topology) {
-            /* auto_topology conflicts with explicit socket/dies/clusters/
-             * cores/threads configuration, they must not be present. */
-            if (virXMLPropString(topology, "sockets") ||
-                virXMLPropString(topology, "dies") ||
-                virXMLPropString(topology, "clusters") ||
-                virXMLPropString(topology, "cores") ||
-                virXMLPropString(topology, "threads")) {
-                virReportError(VIR_ERR_XML_ERROR, "%s",
-                               _("auto_topology conflicts with explicit socket/dies/clusters/cores/threads configuration"));
-                return -1;
-            }
-        } else {
-            if (virXMLPropUInt(topology, "sockets", 10,
-                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                               &def->sockets) < 0) {
-                return -1;
-            }
+        /* Parse explicit topology attributes regardless of auto_topology */
+        if (virXMLPropUInt(topology, "sockets", 10,
+                           VIR_XML_PROP_NONZERO, &def->sockets) < 0)
+            return -1;
 
-            if (virXMLPropUIntDefault(topology, "dies", 10,
-                                      VIR_XML_PROP_NONZERO,
-                                      &def->dies, 1) < 0) {
-                return -1;
-            }
+        if (virXMLPropUIntDefault(topology, "dies", 10,
+                                  VIR_XML_PROP_NONZERO,
+                                  &def->dies, 1) < 0)
+            return -1;
 
-            if (virXMLPropUIntDefault(topology, "clusters", 10,
-                                      VIR_XML_PROP_NONZERO,
-                                      &def->clusters, 1) < 0) {
-                return -1;
-            }
+        if (virXMLPropUIntDefault(topology, "clusters", 10,
+                                  VIR_XML_PROP_NONZERO,
+                                  &def->clusters, 1) < 0)
+            return -1;
 
-            if (virXMLPropUInt(topology, "cores", 10,
-                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                               &def->cores) < 0) {
-                return -1;
+        if (virXMLPropUInt(topology, "cores", 10,
+                           VIR_XML_PROP_NONZERO, &def->cores) < 0)
+            return -1;
+
+        if (virXMLPropUInt(topology, "threads", 10,
+                           VIR_XML_PROP_NONZERO, &def->threads) < 0)
+            return -1;
+
+        /* auto_topology degradation check */
+        if (def->auto_topology) {
+            bool pinned = true;
+
+            if (vcpus && maxvcpus > 0) {
+                for (size_t j = 0; j < maxvcpus; j++) {
+                    if (!vcpus[j]->cpumask ||
+                        virBitmapCountBits(vcpus[j]->cpumask) != 1) {
+                        pinned = false;
+                        break;
+                    }
+                }
+            } else {
+                /* No vcpu info available, cannot verify pinning */
+                pinned = false;
             }
 
-            if (virXMLPropUInt(topology, "threads", 10,
-                               VIR_XML_PROP_REQUIRED | VIR_XML_PROP_NONZERO,
-                               &def->threads) < 0) {
+            if (!pinned) {
+                VIR_WARN("auto_topology='yes' but cputune condition not met: "
+                         "not every vcpu has exactly one pinned pcpu. "
+                         "Falling back to explicit topology configuration.");
+                def->auto_topology = false;
+
+                if (!def->sockets || !def->cores || !def->threads) {
+                    if (maxvcpus > 0) {
+                        /* No explicit topology fallback, use libvirt defaults */
+                        def->sockets = 1;
+                        def->dies = 1;
+                        def->clusters = 1;
+                        def->cores = maxvcpus;
+                        def->threads = 1;
+                    }
+                    /* else: no vcpu info available, leave topology unspecified */
+                }
+            }
+        } else {
+            /* Non-auto_topology mode, explicit topology is required */
+            if (!def->sockets || !def->cores || !def->threads) {
+                virReportError(VIR_ERR_XML_ERROR, "%s",
+                               _("topology sockets, cores, and threads must be specified "
+                                 "when auto_topology is not 'yes'"));
                 return -1;
             }
         }
@@ -1248,7 +1275,7 @@ virCPUDefListParse(const char **xmlCPUs,
         if (!(doc = virXMLParseStringCtxt(xmlCPUs[i], _("(CPU_definition)"), &ctxt)))
             goto error;
 
-        if (virCPUDefParseXML(ctxt, NULL, cpuType, &cpus[i], false) < 0)
+        if (virCPUDefParseXML(ctxt, NULL, cpuType, &cpus[i], false, NULL, 0) < 0)
             goto error;
     }
 
