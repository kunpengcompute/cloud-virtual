diff --git a/src/qemu/qemu_process.c b/src/qemu/qemu_process.c
index 1c6acb40b0..981b78b4de 100644
--- a/src/qemu/qemu_process.c
+++ b/src/qemu/qemu_process.c
@@ -5483,6 +5483,96 @@ qemuProcessSetupRawIO(virDomainObj *vm,
 }
 
 
+/*
+ * qemuProcessSetVcpuPinning:
+ * @vm: domain object
+ * @asyncJob: asynchronous job
+ *
+ * Send the vcpu-to-pcpu pinning information to qemu via the
+ * set-vcpu-pinning QMP command. This must be called before vcpu
+ * threads are created so that qemu can build the PPTT table
+ * according to the host pcpu topology.
+ *
+ * Returns 0 on success, -1 on error.
+ */
+static int
+qemuProcessSetVcpuPinning(virDomainObj *vm,
+                          virDomainAsyncJob asyncJob)
+{
+    qemuDomainObjPrivate *priv = vm->privateData;
+    g_autofree qemuMonitorVcpuPinning *pinning = NULL;
+    size_t npinning = 0;
+    size_t maxvcpus;
+    size_t i;
+    int ret = -1;
+
+    /* Only send the pinning info when auto_topology is requested. */
+    if (!vm->def->cpu || !vm->def->cpu->auto_topology)
+        return 0;
+
+    if (!virQEMUCapsGet(priv->qemuCaps, QEMU_CAPS_SET_VCPU_PINNING)) {
+        virReportError(VIR_ERR_CONFIG_UNSUPPORTED, "%s",
+                       _("set-vcpu-pinning QMP command is not supported by qemu"));
+        return -1;
+    }
+
+    maxvcpus = virDomainDefGetVcpusMax(vm->def);
+    pinning = g_new0(qemuMonitorVcpuPinning, maxvcpus);
+
+    for (i = 0; i < maxvcpus; i++) {
+        virDomainVcpuDef *vcpu = virDomainDefGetVcpu(vm->def, i);
+        ssize_t pcpu;
+
+        if (!vcpu || !vcpu->online)
+            continue;
+
+        if (!vcpu->cpumask) {
+            virReportError(VIR_ERR_CONFIG_UNSUPPORTED,
+                           _("vcpu %1$zu has no cpuset configured, "
+                             "which is required for auto_topology"),
+                           i);
+            return -1;
+        }
+
+        /* auto_topology requires a single pcpu per vcpu so that qemu
+         * can derive the virtual CCL/socket topology from the host
+         * pcpu topology. */
+        pcpu = virBitmapNextSetBit(vcpu->cpumask, -1);
+        if (pcpu < 0) {
+            virReportError(VIR_ERR_CONFIG_UNSUPPORTED,
+                           _("vcpu %1$zu has empty cpuset"), i);
+            return -1;
+        }
+
+        if (virBitmapNextSetBit(vcpu->cpumask, pcpu) >= 0) {
+            virReportError(VIR_ERR_CONFIG_UNSUPPORTED,
+                           _("vcpu %1$zu cpuset must contain exactly "
+                             "one pcpu for auto_topology"), i);
+            return -1;
+        }
+
+        pinning[npinning].vcpu_id = i;
+        pinning[npinning].pcpu_id = pcpu;
+        npinning++;
+    }
+
+    if (npinning == 0)
+        return 0;
+
+    if (qemuDomainObjEnterMonitorAsync(vm, asyncJob) < 0)
+        return -1;
+
+    if (qemuMonitorSetVcpuPinning(priv->mon, true, pinning, npinning) < 0)
+        goto cleanup;
+
+    ret = 0;
+
+ cleanup:
+    qemuDomainObjExitMonitor(vm);
+    return ret;
+}
+
+
 static int
 qemuProcessSetupBalloon(virDomainObj *vm,
                         virDomainAsyncJob asyncJob)
@@ -8164,6 +8254,10 @@ qemuProcessLaunch(virConnectPtr conn,
     if (qemuConnectAgent(driver, vm) < 0)
         goto cleanup;
 
+    VIR_DEBUG("Setting vcpu pinning for flexible CCL topology");
+    if (qemuProcessSetVcpuPinning(vm, asyncJob) < 0)
+        goto cleanup;
+
     VIR_DEBUG("setting up hotpluggable cpus");
     if (qemuDomainHasHotpluggableStartupVcpus(vm->def)) {
         if (qemuDomainRefreshVcpuInfo(vm, asyncJob, false) < 0)
