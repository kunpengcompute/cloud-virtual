diff --git a/src/qemu/qemu_monitor_json.c b/src/qemu/qemu_monitor_json.c
index 8f0e36e515..5cd0de102f 100644
--- a/src/qemu/qemu_monitor_json.c
+++ b/src/qemu/qemu_monitor_json.c
@@ -2843,6 +2843,51 @@ qemuMonitorJSONSetBalloon(qemuMonitor *mon,
 }
 
 
+int
+qemuMonitorJSONSetVcpuPinning(qemuMonitor *mon,
+                              bool auto_topology,
+                              qemuMonitorVcpuPinning *pinning,
+                              size_t npinning)
+{
+    g_autoptr(virJSONValue) cmd = NULL;
+    g_autoptr(virJSONValue) reply = NULL;
+    g_autoptr(virJSONValue) vcpu_pinning = NULL;
+    size_t i;
+
+    vcpu_pinning = virJSONValueNewArray();
+
+    for (i = 0; i < npinning; i++) {
+        g_autoptr(virJSONValue) entry = virJSONValueNewObject();
+
+        if (virJSONValueObjectAppendNumberInt(entry, "vcpu-id",
+                                              pinning[i].vcpu_id) < 0)
+            return -1;
+
+        if (virJSONValueObjectAppendNumberInt(entry, "pcpu-id",
+                                              pinning[i].pcpu_id) < 0)
+            return -1;
+
+        if (virJSONValueArrayAppend(vcpu_pinning, &entry) < 0)
+            return -1;
+    }
+
+    cmd = qemuMonitorJSONMakeCommand("set-vcpu-pinning",
+                                     "b:auto-topology", auto_topology,
+                                     "a:vcpu-pinning", &vcpu_pinning,
+                                     NULL);
+    if (!cmd)
+        return -1;
+
+    if (qemuMonitorJSONCommand(mon, cmd, &reply) < 0)
+        return -1;
+
+    if (qemuMonitorJSONCheckError(cmd, reply) < 0)
+        return -1;
+
+    return 0;
+}
+
+
 static int qemuMonitorJSONSaveMemory(qemuMonitor *mon,
                                      const char *cmdtype,
                                      unsigned long long offset,
